# ==============================================================================
# Resume Agent Backend - Environment Configuration Template (Phase 4D)
# Placeholders only. NEVER commit real credentials or secrets to version control.
# ==============================================================================

# ==============================================================================
# 1. LOCAL DEVELOPMENT SETUP (Defaults)
# ==============================================================================
# DEBUG: Set to True for development with detailed console logs and auto-reload
DEBUG=True

# SECRET_KEY: Development default is provided automatically, but can be customized
SECRET_KEY=django-insecure-dev-phase1-resume-agent-secret-key-1234567890

# ALLOWED_HOSTS: Development allows local host interfaces
ALLOWED_HOSTS=localhost,127.0.0.1

# DATABASE_URL: SQLite is default for local development
DATABASE_URL=sqlite:///db.sqlite3

# FRONTEND_URL: Local Vite development server origin
FRONTEND_URL=http://localhost:5173

# CORS & CSRF: Local development origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# GOOGLE GEMINI API KEY: Required for AI analysis
GEMINI_API_KEY=your_gemini_api_key_here

# RATE LIMITING: Password reset throttle rate
PASSWORD_RESET_RATE_LIMIT=5/hour

# EMAIL DELIVERY - OPTION A: Console Backend (Prints emails directly to the console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# EMAIL DELIVERY - OPTION B: Gmail SMTP for local testing (Use an App Password)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=Resume Agent <noreply@resumeagent.ai>

# ==============================================================================
# 2. PRODUCTION ENVIRONMENT SETUP (Required when DEBUG=False)
# ==============================================================================
# Set DEBUG to False in production
# DEBUG=False

# Generate a strong 50+ char random secret key:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
# SECRET_KEY=replace-with-a-secure-50-character-random-secret-key-in-production

# Comma-separated production domains (Wildcards are forbidden in production)
# ALLOWED_HOSTS=resumeagent.ai,api.resumeagent.ai

# Production PostgreSQL Database URL
# DATABASE_URL=postgres://user:password@hostname:5432/resume_agent_db

# Production Frontend HTTPS URL (Password reset links use this URL)
# FRONTEND_URL=https://resumeagent.ai

# Production CORS & CSRF (Explicit HTTPS origins)
# CORS_ALLOWED_ORIGINS=https://resumeagent.ai
# CSRF_TRUSTED_ORIGINS=https://resumeagent.ai

# Production SMTP Email Delivery (Gmail, SendGrid, Amazon SES, Mailgun, etc.)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=production_email@yourdomain.com
# EMAIL_HOST_PASSWORD=your_production_smtp_password
# DEFAULT_FROM_EMAIL=Resume Agent <noreply@yourdomain.com>

# Production SSL & Cookie Hardening
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# Production Shared Cache (Optional: required for multi-instance distributed rate limiting)
# REDIS_URL=redis://default:password@hostname:6379/0

# Production Cloud Media Storage (Optional: switch from local filesystem to S3/R2/GCS)
# DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage

