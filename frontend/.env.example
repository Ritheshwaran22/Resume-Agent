# ==============================================================================
# Resume Agent Frontend - Environment Configuration Template (Phase 4E)
# ==============================================================================

# Local Development:
# Leave empty to use the Vite local proxy configured in vite.config.js,
# or specify the local backend server address:
VITE_API_BASE_URL=http://127.0.0.1:8000

# Production Deployment:
# Point to your deployed HTTPS Django backend domain (do not include trailing slash):
# VITE_API_BASE_URL=https://api.yourdomain.com

# ==============================================================================
# SECURITY REMINDER:
# Variables with the VITE_ prefix are embedded into the client-facing JavaScript bundle!
# NEVER put SECRET_KEY, GEMINI_API_KEY, SMTP passwords, or database credentials here.
# ==============================================================================
